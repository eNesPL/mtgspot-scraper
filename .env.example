# Ścieżka do lokalnej bazy SQLite
MTGSPOT_DB_PATH=./mtgspot.db

# Konfiguracja integracji z aplikacją Karty (źródło prawdy dla buylisty)
# Adres bazowy API aplikacji Karty (w produkcji wymagany HTTPS, chyba że ustawiono KARTY_ALLOW_HTTP=true)
KARTY_API_URL=http://localhost:3000

# Wspólny token autoryzacyjny (musi być identyczny z MTGSPOT_SYNC_TOKEN w aplikacji Karty, min. 8 znaków)
KARTY_SYNC_TOKEN=change-me-to-a-long-random-integration-secret

# Interwał automatycznej synchronizacji buylisty Karty w sekundach (domyślnie 300 = 5 minut)
MTGSPOT_KARTY_SYNC_INTERVAL_SECONDS=300
